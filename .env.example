# Copy to .env (git-ignored). Never commit real secrets.
ERAPAY_ENV=development
ERAPAY_HTTP_ADDR=:8080
ERAPAY_DATABASE_URL=postgres://erapay:erapay_dev_only@localhost:5432/erapay?sslmode=disable
ERAPAY_REDIS_URL=redis://localhost:6379/0

# DOKU sandbox credentials: fill locally only, never commit or paste in chat/logs.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Kunci privat RSA merchant (PEM; newline boleh ditulis sebagai escape literal \n)
# ATAU path file (mis. doku.key). Jangan commit.
DOKU_PRIVATE_KEY=
DOKU_PRIVATE_KEY_FILE=
# terminalId 3-16 alfanumerik dan kode pos untuk QRIS generate (dari DOKU/registrasi QRIS).
DOKU_TERMINAL_ID=
DOKU_POSTAL_CODE=
# Kosong = sandbox https://api-sandbox.doku.com (produksi hanya bila ERAPAY_ENV=production).
DOKU_BASE_URL=
# Biarkan false sampai kode latestTransactionStatus QRIS diverifikasi di sandbox DOKU.
DOKU_QRIS_STATUS_MAP_CONFIRMED=false

# Frontend (SvelteKit) → alamat Go API
ERAPAY_API_URL=http://localhost:8080

# Integration test PostgreSQL (role butuh CREATEDB; tiap test membuat DB sementara).
# Tanpa ini test integrasi di-skip. Jika port 5432 bentrok: ERAPAY_PG_PORT=55432 saat `compose up`.
ERAPAY_TEST_DATABASE_URL=postgres://erapay:erapay_dev_only@localhost:5432/postgres?sslmode=disable

# Peer yang boleh mengirim X-Forwarded-For (server SvelteKit), CIDR dipisah koma.
ERAPAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Email (verifikasi pendaftaran, lupa sandi). Tanpa ERAPAY_SMTP_HOST, di luar development pendaftaran mandiri,
# verifikasi email, dan reset sandi NONAKTIF (404). Di development, email hanya dicatat di log API.
# Port 587 = STARTTLS, 465 = TLS langsung. ERAPAY_WEB_URL = alamat publik dashboard (https di production), dipakai di tautan email.
ERAPAY_SMTP_HOST=
ERAPAY_SMTP_PORT=587
ERAPAY_SMTP_USER=
ERAPAY_SMTP_PASSWORD=
ERAPAY_SMTP_FROM=EraPay <no-reply@example.com>
ERAPAY_WEB_URL=http://localhost:5173
# Batas percobaan daftar per IP per jam (naikkan bila banyak pengguna berbagi satu IP, mis. kantor/CGNAT).
ERAPAY_REGISTER_PER_IP_HOUR=5

# Kap MDR (opsional). Aturan BI QRIS: MDR 0,7% dibatasi maks Rp500 untuk nominal Rp0-Rp100.000,
# efektif 1 Nov 2026 (docs/integrations/doku.md §6). Default kosong = tanpa kap (perilaku lama).
# Untuk mengaktifkan: ERAPAY_MDR_CAP=500 dan ERAPAY_MDR_CAP_UPTO=100000 saat tanggalnya tiba.
ERAPAY_MDR_CAP=
ERAPAY_MDR_CAP_UPTO=

# 1 = simpan notifikasi mentah gateway di POST /webhooks/{gateway}[/...] (tanpa memproses; lihat doku.md §8).
# Matikan (kosongkan) setelah payload QRIS tertangkap dan parser resmi dibuat.
ERAPAY_WEBHOOK_CAPTURE=

# Kunci 32 byte (hex 64 karakter atau base64) untuk mengenkripsi secret at-rest, mis. signing secret webhook merchant,
# NIK/NPWP data diri merchant, nomor rekening payout. Buat: openssl rand -hex 32.
# Kosong = webhook outbound ke merchant, pembayaran via rekening bank, payout, dan pendaftaran mandiri nonaktif.
# Pendaftaran wajib: NIK/NPWP tidak bisa disimpan tanpa kunci ini (CanRegister false tanpa kunci).
ERAPAY_ENCRYPTION_KEY=

# Kebijakan payout (PRD payout.md menandai ini OPEN; nilai di bawah hanya default sementara). Satuan: rupiah.
# Payout nyata di produksi tetap TERTUTUP sampai ERAPAY_PAYOUT_LIVE=1 (go/no-go). Butuh ERAPAY_ENCRYPTION_KEY.
ERAPAY_PAYOUT_LIVE=
ERAPAY_PAYOUT_MIN=10000
ERAPAY_PAYOUT_MAX=50000000
ERAPAY_PAYOUT_DAILY_LIMIT=200000000
ERAPAY_PAYOUT_COOLING=24h

# Executor payout Kirim DOKU (doku.md §6). Identitas pengirim = badan usaha PT (lihat docs/prd/payout.md).
# ERAPAY_PAYOUT_FEE: fallback biaya transfer per payout berhasil (dari inquiry saat dipakai; satuan rupiah).
# ERAPAY_PAYOUT_CASH_ACCOUNT: akun ledger sumber dana, cash_bank_pt (default) | cash_doku_clearing — [KD] sampai konfirmasi tertulis.
# ERAPAY_PAYOUT_CHANNEL_CODE: 07 Bank Deposit | 11 BI-FAST; kosong = default gateway.
# ERAPAY_PAYOUT_SERVICE_CODE: [?] service code transfer untuk check-status (tunggu DOKU).
ERAPAY_PAYOUT_FEE=1500
ERAPAY_PAYOUT_CASH_ACCOUNT=cash_bank_pt
ERAPAY_PAYOUT_CHANNEL_CODE=
ERAPAY_PAYOUT_SERVICE_CODE=
ERAPAY_PAYOUT_SENDER_PHONE=6281234567890
ERAPAY_PAYOUT_SENDER_FIRST_NAME=PT EraPay
ERAPAY_PAYOUT_SENDER_LAST_NAME=Digital Solusindo
ERAPAY_PAYOUT_SENDER_ID=0123456789012345
ERAPAY_PAYOUT_SENDER_ID_TYPE=KTP

# Probe uji produksi Kirim DOKU (cmd/kdtest; tanpa ledger/domain, ada biaya sungguhan — doku.md §6).
# KD_TO_* = rekening tujuan uji, sebaiknya milik PT sendiri; identitas pengirim memakai ERAPAY_PAYOUT_SENDER_* di atas.
# Stage: kdtest balance (gratis) → kdtest inquiry (Rp500) → kdtest transfer <sessionId> (uang asli, min Rp10.000)
#        → kdtest status <partnerRef> (KD_SERVICE_CODE dibaca dari digit 4-5 responseCode transfer).
KD_TO_BANK=
KD_TO_ACCOUNT=
KD_TO_NAME=
KD_AMOUNT=10000
KD_SERVICE_CODE=

# Rahasia server-ke-server untuk menghubungkan tenant ARUS (minimal 32 karakter; samakan di backend ARUS).
# ERAPAY_ARUS_PROVISION_TOKEN=

# Wizard KYC (/v1/kyc/*) nonaktif tanpa ini + ERAPAY_ENCRYPTION_KEY. Direktori lokal untuk dokumen & bukti.
# Berkas dienkripsi AES-256-GCM dengan ERAPAY_ENCRYPTION_KEY sebelum ditulis: kunci hilang = berkas tidak bisa dibuka,
# jadi backup kunci terpisah dari backup folder. Berkas lama: go run ./cmd/kycencrypt (lihat docs/prd/security.md).
ERAPAY_KYC_STORAGE_DIR=./data/kyc
