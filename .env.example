# Copy to .env (git-ignored). Never commit real secrets.
ERAPAY_ENV=development
ERAPAY_HTTP_ADDR=:8080
ERAPAY_DATABASE_URL=postgres://erapay:erapay_dev_only@localhost:5432/erapay?sslmode=disable
ERAPAY_REDIS_URL=redis://localhost:6379/0

# DOKU sandbox credentials: fill locally only, never commit or paste in chat/logs.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
# Kunci privat RSA merchant (PEM; 
 literal boleh) ATAU path file. Jangan commit.
DOKU_PRIVATE_KEY=
DOKU_PRIVATE_KEY_FILE=
# terminalId 3-16 alfanumerik dan kode pos untuk QRIS generate (dari DOKU/registrasi QRIS).
DOKU_TERMINAL_ID=
DOKU_POSTAL_CODE=
# Kosong = sandbox https://api-sandbox.doku.com (produksi hanya bila ERAPAY_ENV=production).
DOKU_BASE_URL=
# Biarkan false sampai kode latestTransactionStatus QRIS diverifikasi di sandbox DOKU.
DOKU_QRIS_STATUS_MAP_CONFIRMED=false

# Frontend (SvelteKit) → alamat Go API
ERAPAY_API_URL=http://localhost:8080

# Integration test PostgreSQL (role butuh CREATEDB; tiap test membuat DB sementara).
# Tanpa ini test integrasi di-skip. Jika port 5432 bentrok: ERAPAY_PG_PORT=55432 saat `compose up`.
ERAPAY_TEST_DATABASE_URL=postgres://erapay:erapay_dev_only@localhost:5432/postgres?sslmode=disable

# Peer yang boleh mengirim X-Forwarded-For (server SvelteKit), CIDR dipisah koma.
ERAPAY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Email (verifikasi pendaftaran, lupa sandi). Tanpa ERAPAY_SMTP_HOST, di luar development pendaftaran mandiri,
# verifikasi email, dan reset sandi NONAKTIF (404). Di development, email hanya dicatat di log API.
# Port 587 = STARTTLS, 465 = TLS langsung. ERAPAY_WEB_URL = alamat publik dashboard (https di production), dipakai di tautan email.
ERAPAY_SMTP_HOST=
ERAPAY_SMTP_PORT=587
ERAPAY_SMTP_USER=
ERAPAY_SMTP_PASSWORD=
ERAPAY_SMTP_FROM=EraPay <no-reply@example.com>
ERAPAY_WEB_URL=http://localhost:5173
# Batas percobaan daftar per IP per jam (naikkan bila banyak pengguna berbagi satu IP, mis. kantor/CGNAT).
ERAPAY_REGISTER_PER_IP_HOUR=5

# 1 = simpan notifikasi mentah gateway di POST /webhooks/{gateway}[/...] (tanpa memproses; lihat doku.md §8).
# Matikan (kosongkan) setelah payload QRIS tertangkap dan parser resmi dibuat.
ERAPAY_WEBHOOK_CAPTURE=

# Kunci 32 byte (hex 64 karakter atau base64) untuk mengenkripsi secret at-rest, mis. signing secret webhook merchant.
# Buat: openssl rand -hex 32. Kosong = webhook outbound ke merchant nonaktif. Jangan commit nilai asli.
ERAPAY_ENCRYPTION_KEY=

# Kebijakan payout (PRD payout.md menandai ini OPEN; nilai di bawah hanya default sementara). Satuan: rupiah.
# Payout nyata di produksi tetap TERTUTUP sampai ERAPAY_PAYOUT_LIVE=1 (go/no-go). Butuh ERAPAY_ENCRYPTION_KEY.
ERAPAY_PAYOUT_LIVE=
ERAPAY_PAYOUT_MIN=10000
ERAPAY_PAYOUT_MAX=50000000
ERAPAY_PAYOUT_DAILY_LIMIT=200000000
ERAPAY_PAYOUT_COOLING=24h

# Rahasia server-ke-server untuk menghubungkan tenant ARUS (minimal 32 karakter; samakan di backend ARUS).
# ERAPAY_ARUS_PROVISION_TOKEN=
